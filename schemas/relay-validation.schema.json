{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amzsdq/RRuleR/schemas/relay-validation.schema.json",
  "title": "RRuleR Relay Validation",
  "type": "object",
  "required": ["schema_version", "validation_id", "canonical_automation_id", "status", "acceptance", "pass_rule", "next_action"],
  "properties": {
    "schema_version": {"type": "string"},
    "validation_id": {"type": "string", "minLength": 1},
    "canonical_automation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["IN_PROGRESS", "PASS", "FAIL"]},
    "acceptance": {
      "type": "object",
      "required": [
        "canonical_id_preserved",
        "recurring_rrule_preserved",
        "two_or_more_phase_transitions",
        "scheduled_cold_continuation_from_github",
        "additional_cycle_without_continuation_loss",
        "github_state_coherent",
        "runtime_timeout_does_not_break_cycle",
        "overlap_or_serialization_semantics_classified",
        "utilization_handoff_measurement"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["PASS", "PASS_WITH_SCOPE", "PENDING", "FAIL"]}
        }
      }
    },
    "pass_rule": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amzsdq/RRuleR/schemas/run-observation.schema.json",
  "title": "RRuleR Run Observation",
  "type": "object",
  "required": ["observation_id","root_job_id","canonical_automation_id","run_started_at","classification"],
  "properties": {
    "observation_id":{"type":"string","minLength":1},
    "root_job_id":{"type":"string","minLength":1},
    "canonical_automation_id":{"type":"string","minLength":1},
    "run_started_at":{"type":"string","minLength":1},
    "run_ended_at":{"type":["string","null"]},
    "end_reason":{"type":["string","null"],"enum":[null,"PROGRAM_COMPLETE","BLOCKED_EXTERNAL","VERIFIED_SAME_CANONICAL_CONTINUATION","VERIFIED_SAME_CANONICAL_EXACT_ONE_SHOT_CONTINUATION","VERIFIED_SAME_CANONICAL_CUSTOM_RECURRING_CONTINUATION","COMMITTED_SUCCESSOR_HANDOFF","EXPLICIT_OPERATOR_STOP","PLATFORM_ENFORCED_TERMINATION"]},
    "program_status_at_end":{"type":["string","null"]},
    "successor_observed_at":{"type":["string","null"]},
    "productive_substantive_seconds":{"type":["integer","null"],"minimum":0},
    "checkpoint_seconds":{"type":["integer","null"],"minimum":0},
    "handoff_seconds":{"type":["integer","null"],"minimum":0},
    "relay_idle_gap_seconds":{"type":["integer","null"],"minimum":0},
    "successor_wait_seconds":{"type":["integer","null"],"minimum":0},
    "classification":{"enum":["ACTIVE","HANDOFF","COMPLETE","BLOCKED_EXTERNAL","PLATFORM_ENDED","DEGRADED_CONTINUATION"]},
    "notes":{"type":"string"},
    "duration_seconds":{"type":["integer","null"],"minimum":0},
    "turn_outcome":{"type":["string","null"],"enum":[null,"CONTINUE","COMPLETE","BLOCKED","PAUSED"]},
    "short_turn_reason":{"type":["string","null"],"enum":[null,"PLATFORM_ENFORCED_TERMINATION","EXPLICIT_OPERATOR_INTERVENTION","AUTHORITY_OR_FENCING_FAIL_CLOSED","NO_SAFE_RUNNABLE_WORK_AFTER_EXPLICIT_SCAN"]},
    "alternatives_checked":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true},
    "close_decision":{"enum":["TIME_BOUNDARY","TARGET_REACHED_SAFE_BOUNDARY","BUDGET_EXHAUSTED","EXCEPTION","HANDOFF","TERMINAL"]},
    "close_reserve_seconds":{"type":"number","minimum":0},
    "verified_next_fast_due_at":{"type":["string","null"]},
    "normal_close_offset_seconds":{"type":["integer","null"],"minimum":0},
    "chat_trace_policy":{"type":"string"},
    "schedule_trace_verified":{"type":"boolean"},
    "final_due_trace_verified":{"type":"boolean"},
    "unit_completion_traces":{"type":"array","items":{"type":"object","required":["unit_id","start_at","end_at","duration_seconds","artifact","work_evidence_ref","message","durably_persisted","continued_same_wake"],"properties":{"unit_id":{"type":"string","minLength":1},"start_at":{"type":"string","minLength":1},"end_at":{"type":"string","minLength":1},"duration_seconds":{"type":"integer","minimum":1},"artifact":{"type":"string","minLength":1},"work_evidence_ref":{"type":"string","minLength":1},"message":{"type":"string","minLength":1},"durably_persisted":{"const":true},"continued_same_wake":{"type":"boolean"},"source_kind":{"type":"string"}},"additionalProperties":false}}
  },
  "allOf": [
    {"if":{"properties":{"run_ended_at":{"type":"string"}},"required":["run_ended_at"]},"then":{"required":["end_reason","program_status_at_end","duration_seconds","turn_outcome","close_decision"],"properties":{"duration_seconds":{"type":"integer","minimum":0},"turn_outcome":{"type":"string"},"close_decision":{"type":"string"}}}},
    {"if":{"properties":{"end_reason":{"const":"VERIFIED_SAME_CANONICAL_CONTINUATION"}},"required":["end_reason"]},"then":{"required":["verified_next_fast_due_at","normal_close_offset_seconds"],"properties":{"verified_next_fast_due_at":{"type":"string"},"normal_close_offset_seconds":{"const":60}}}},
    {"if":{"properties":{"end_reason":{"const":"COMMITTED_SUCCESSOR_HANDOFF"}},"required":["end_reason"]},"then":{"required":["successor_observed_at"],"properties":{"successor_observed_at":{"type":"string"}}}},
    {"if":{"properties":{"turn_outcome":{"const":"CONTINUE"},"duration_seconds":{"type":"integer","maximum":599}},"required":["turn_outcome","duration_seconds"]},"then":{"required":["short_turn_reason"],"properties":{"short_turn_reason":{"const":"PLATFORM_ENFORCED_TERMINATION"},"close_decision":{"const":"EXCEPTION"},"end_reason":{"const":"PLATFORM_ENFORCED_TERMINATION"}}}},
    {"if":{"properties":{"chat_trace_policy":{"const":"DURABLE_UNIT_CHAT_TRACE_CANARY_V5_5"}},"required":["chat_trace_policy"]},"then":{"required":["schedule_trace_verified","unit_completion_traces"],"properties":{"schedule_trace_verified":{"const":true}}}},
    {"if":{"properties":{"chat_trace_policy":{"const":"DURABLE_UNIT_CHAT_TRACE_CANARY_V5_5"},"turn_outcome":{"const":"CONTINUE"}},"required":["chat_trace_policy","turn_outcome"]},"then":{"required":["final_due_trace_verified"],"properties":{"final_due_trace_verified":{"const":true}}}}
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amzsdq/RRuleR/schemas/relay-event.schema.json",
  "title": "RRuleR Relay Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "root_job_id",
    "authority_epoch",
    "canonical_automation_id"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {
      "enum": [
        "WAKE_ARMED",
        "WAKE_UPDATE_VERIFIED",
        "WORK_STARTED",
        "CHECKPOINT",
        "SUCCESSOR_OBSERVED",
        "HANDOFF",
        "DEGRADED_CONTINUATION",
        "COMPLETE",
        "BLOCKED_EXTERNAL"
      ]
    },
    "occurred_at": {"type": "string", "minLength": 1},
    "root_job_id": {"type": "string", "minLength": 1},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "canonical_automation_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": ["string", "null"]},
    "details": {"type": "object"}
  },
  "additionalProperties": false
}

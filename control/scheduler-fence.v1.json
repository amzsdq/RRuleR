{
  "policy_id":"RRULER_SCHEDULER_FENCE",
  "version":3,
  "status":"ACTIVE",
  "purpose":"Prevent stale schedule rollback while supporting rolling same-canonical provisional rescue and completion-relative fast continuation.",
  "authoritative_expected_due_path":"state/CURRENT.json#/continuation/next_due_at",
  "active_lifecycle_policy":"control/rolling-rrule-lifecycle.v1.json",
  "startup_order":[
    "READ_FRESH_CURRENT_AND_LIVE_CANONICAL",
    "COMPARE_ACTUAL_WAKE_AND_EXPECTED_DUE",
    "IF_VALID_OR_RECOVERABLE_PRESERVE_NEWEST_VERIFIED_LIVE_CONTINUATION",
    "RECONCILE_CURRENT_ACTIVITY_HANDOFF_FORWARD",
    "CLAIM_FRESH_AUTHORITY_IF_NEEDED",
    "PROVISIONAL_ARM_AND_VERIFY",
    "CONTINUE_WORK_PROTOCOL"
  ],
  "stale_wake_definition":"A wake whose occurrence belongs to an older schedule generation and conflicts with the newest verified durable/live continuation.",
  "stale_wake_action":"RECOVER_FORWARD_NO_ROLLBACK",
  "expected_due_tolerance_seconds":240,
  "queued_old_occurrence_must_not_disable_canonical":true,
  "queued_old_occurrence_must_not_restore_old_prompt_or_title":true,
  "queued_old_occurrence_must_not_roll_dstart_backward":true,
  "scheduler_mechanism":"RRULE_HOURLY_ROLLING_COMPLETION_RELATIVE",
  "expected_wake_action":"VALIDATE_FENCE_THEN_PROVISIONAL_ARM_SAME_CANONICAL_AND_VERIFY_BEFORE_FULL_RESTORE_WORK",
  "timing_defaults":{"target_useful_work_seconds":600,"provisional_safety_margin_seconds":180,"final_rearm_offset_seconds":60},
  "recovery_policy":{
    "nonterminal_mismatch_is_blocking":false,
    "no_op_due_to_stale_timing_forbidden":true,
    "preserve_newest_verified_live_schedule":true,
    "rollback_schedule_generation_forbidden":true,
    "rollback_authority_epoch_forbidden":true,
    "reconcile_to_newest_verified_future_wake":true,
    "actual_platform_or_security_blockers_still_apply":true
  },
  "compatibility_note":"Fixed quarter-hour rotation is retired as the active policy after the controlled same-canonical two-wake +2m canary passed. Historical quarter-cycle evidence remains valid history, not current scheduling instruction."
}

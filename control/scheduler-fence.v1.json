{
  "policy_id": "RRULER_SCHEDULER_FENCE",
  "version": 2,
  "status": "ACTIVE",
  "purpose": "Prevent stale schedule rollback while ensuring non-terminal scheduler drift self-recovers instead of idling.",
  "authoritative_expected_due_path": "state/CURRENT.json#/continuation/next_due_at",
  "startup_order": [
    "READ_FRESH_CURRENT_AND_LIVE_CANONICAL",
    "COMPARE_ACTUAL_WAKE_AND_EXPECTED_DUE",
    "IF_MATCH_REARM_AND_VERIFY",
    "IF_MISMATCH_PRESERVE_NEWEST_VERIFIED_LIVE_CONTINUATION",
    "RECONCILE_CURRENT_ACTIVITY_HANDOFF_FORWARD",
    "CLAIM_FRESH_AUTHORITY_IF_NEEDED",
    "CONTINUE_HANDOFF_AND_WORK_PROTOCOL"
  ],
  "stale_wake_definition": "A wake whose scheduled/actual occurrence belongs to an older schedule generation and does not match the current durable expected due window.",
  "stale_wake_action": "RECOVER_FORWARD_NO_ROLLBACK",
  "expected_due_tolerance_seconds": 240,
  "queued_old_occurrence_must_not_disable_canonical": true,
  "queued_old_occurrence_must_not_restore_old_prompt_or_title": true,
  "scheduler_mechanism": "RRULE_HOURLY_QUARTER_SELF_SHIFT",
  "expected_phase_cycle_minutes": [
    0,
    15,
    30,
    45
  ],
  "expected_transition_map": {
    "0": 15,
    "15": 30,
    "30": 45,
    "45": 0
  },
  "expected_wake_action": "REARM_SAME_CANONICAL_TO_NEXT_QUARTER_SLOT_AND_VERIFY_BEFORE_WORK",
  "recovery_policy": {
    "nonterminal_mismatch_is_blocking": false,
    "no_op_due_to_stale_timing_forbidden": true,
    "preserve_newest_verified_live_schedule": true,
    "rollback_schedule_generation_forbidden": true,
    "rollback_authority_epoch_forbidden": true,
    "reconcile_to_future_quarter_wake_when_live_canonical_verified": true,
    "actual_platform_or_security_blockers_still_apply": true
  }
}

  "conflict_rule": "On every wake, follow scheduler_execution_contract in numeric order. Fresh GitHub is authoritative for dynamic work/state. Early or late scheduler timing alone never justifies idling when single authority is safe. Scheduler identity invariants are fixed: automation_id=6ab152b636748191a71873ba4d5ef551, is_enabled=true, exact_schedule, and RRULE:FREQ=HOURLY on every schedule mutation. Final nonterminal close targets observed end + 2 minutes (120 seconds).",
  "scheduler_execution_contract": {
    "automation_id": "6ab152b636748191a71873ba4d5ef551",
    "is_enabled_required": true,
    "timing_mode": "exact_schedule",
    "schedule_shape": "BEGIN:VEVENT\\nDTSTART;TZID=Asia/Seoul:<YYYYMMDDTHHMMSS>\\nRRULE:FREQ=HOURLY\\nEND:VEVENT",
    "forbidden": [
      "DTSTART_ONLY_ONE_SHOT",
      "dtstart_offset_json",
      "NEW_MAIN_AUTOMATION",
      "DISABLE_MAIN",
      "REMOVE_RRULE"
    ],
    "ordered_steps": [
      "FRESH_STATE",
      "AUTHORITY",
      "PROVISIONAL_RRULE_ARM",
      "PROVISIONAL_LIVE_VERIFY",
      "PROVISIONAL_CHAT_TRACE",
      "SUBSTANTIVE_WORK",
      "UNIT_PERSIST_AND_CHAT",
      "CLOSE_PREP",
      "FINAL_RRULE_WRITE",
      "FINAL_LIVE_VERIFY",
      "DURABLE_FOLLOWER_SYNC",
      "FINAL_CHAT_TRACE",
      "TELEMETRY",
      "TURN_FOOTER"
    ],
    "final_writer_rule": "FINAL_RRULE_WRITE is the last scheduler mutation of the wake; durable projections follow the verified live due and never overwrite it.",
    "final_rearm_offset_seconds": 120,
    "final_rearm_offset_human": "2 minutes (120 seconds)"
  }

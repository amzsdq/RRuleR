  "hard_invariants":["DURABLE_STATE_IS_AUTHORITATIVE_FOR_PROGRAM_TASK_AUTHORITY_AND_CHECKPOINTS","LIVE_VERIFIED_SAME_MAIN_SCHEDULE_IS_AUTHORITATIVE_FOR_CURRENT_SCHEDULER_DUE","FRESH_ACTIVE_CONTROLS_AND_MANDATORY_POLICY_SYNC_REQUIRED_EVERY_WAKE","ACTIVE_POLICY_CHANGES_MUST_UPDATE_ENFORCING_CI_SURFACES_IN_SAME_CHANGE_SET_OR_FAIL_CLOSED","P0_SCORECARD_MUST_BE_FRESH_ON_EVERY_WAKE_AND_MATCH_OPERATOR_LOCKED_600_SECOND_WORK_FLOOR_AND_60_SECOND_FINAL_REARM","NORMAL_NONTERMINAL_CONTINUE_VOLUNTARY_CLOSE_BEFORE_600S_FORBIDDEN","AUTHORITY_EPOCH_MONOTONIC","MINIMUM_FENCE_THEN_PROVISIONAL_REARM_AND_VERIFY_BEFORE_FULL_RESTORE_OR_SUBSTANTIVE_WORK","PREDICTIVE_PREARM_MUST_NOT_CREATE_DUAL_SUBSTANTIVE_AUTHORITY","STALE_WAKE_MUST_NOT_ROLL_DSTART_OR_AUTHORITY_BACKWARD","NONTERMINAL_PROGRAM_MUST_RETAIN_VERIFIED_CONTINUATION","DUPLICATE_SUBSTANTIVE_SIDE_EFFECTS_FORBIDDEN","CANONICAL_DISABLE_ONLY_ON_PROGRAM_TERMINAL_OR_EXPLICIT_OPERATOR_STOP","FAILED_INTERVENTION_MUST_NOT_BE_REPEATED_WITHOUT_NEW_EVIDENCE","INCOMPLETE_OR_INFERRED_UTILIZATION_WINDOW_MUST_NOT_BE_PROMOTED","CALLER_SUPPLIED_OBSERVATION_HORIZON_MUST_NOT_EXCEED_DURABLE_TRUSTED_HORIZON","STARTUP_RECEIPTS_MUST_NOT_BE_INFERRED","STARTUP_BOOT_RECEIPT_MUST_MATCH_CURRENT_GENERATION","NORMAL_CONTINUATION_DEPENDS_ONLY_ON_SAME_MAIN","WATCHDOG_DISABLED_STANDBY_NOT_NORMAL_DEPENDENCY","SAME_MAIN_RECURRING_RRULE_IS_COLD_FALLBACK","RETIRED_MAIN_CANONICAL_MUST_NEVER_REACTIVATE","ALL_RETIRED_MAIN_CANONICALS_MUST_NEVER_REACTIVATE","SAME_MAIN_PROVISIONAL_MATCHES_BOUNDED_ENVELOPE_AND_AVOIDS_SHORT_ROLLING_COLLISION","DURABLY_PERSISTED_BOUNDED_UNIT_COMPLETION_EMITS_USER_VISIBLE_TRACE_WITHOUT_END_AUTHORITY","DURABLY_PERSISTED_BOUNDED_UNIT_COMPLETION_EMITS_OR_QUEUES_USER_VISIBLE_TRACE_WITHOUT_END_AUTHORITY","TRACE_DELIVERY_STATE_MUST_NOT_BE_INFERRED_FROM_EXECUTION_EVIDENCE","ALL_HUMAN_READABLE_TIME_OFFSETS_MUST_INCLUDE_EXPLICIT_UNITS","SCHEDULER_JITTER_MUST_NOT_CAUSE_VOLUNTARY_IDLE_WHEN_SINGLE_AUTHORITY_CAN_BE_SAFELY_CLAIMED","EVERY_NONTERMINAL_EXIT_MUST_END_WITH_SAME_MAIN_FULL_VEVENT_RRULE_FINAL_REARM_TO_CLOSE_PLUS_1_MINUTE_60_SECONDS_UNLESS_EXPLICIT_STOP_PAUSE_TERMINAL_OR_REARM_FORBIDDEN_AUTHORITY_CONFLICT","FINAL_LIVE_RRULE_WRITE_IS_LAST_SCHEDULE_MUTATION_OF_WAKE_AND_DURABLE_PROJECTIONS_MUST_FOLLOW_IT_NOT_OVERWRITE_IT"],
  "conflict_rule":"Fresh GitHub durable state is authoritative for program/task/authority/checkpoint semantics; the live-verified SAME MAIN schedule is authoritative for the scheduler's current due. P0 is useful-work duty cycle. Scheduler updates use the SAME MAIN automation and a full VEVENT containing DTSTART plus RRULE:FREQ=HOURLY with enabled=true. Pre-work provisional arming is crash insurance only. The LAST schedule write of every nonterminal wake is close + 1 minute (60 seconds); once live-verified, no later same-wake reconciliation may mutate schedule. Durable CURRENT/ACTIVITY/HANDOFF copy that verified live due and may never push an older/provisional due back into the scheduler. A durable unit trace satisfies the legacy emit invariant by being queued for guaranteed user-visible final flush when reliable intermediate delivery is unavailable; delivery state is tracked separately. Provider jitter is tolerated. Never reactivate retired MAIN canonicals; Watchdog remains disabled standby."

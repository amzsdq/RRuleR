{
  "policy_id": "RRULER_RELAY_POLICY",
  "version": 1,
  "policy_revision": 5,
  "status": "ACTIVE",
  "source_of_truth": "GITHUB_DURABLE_STATE",
  "scheduler": {
    "mechanism": "RRULE_HOURLY_SELF_SHIFT_FROM_ACTUAL_WAKE",
    "canonical_reuse_required": true,
    "one_shot_conversion_forbidden": true,
    "replacement_automation_forbidden": true,
    "rrule_frequency": "HOURLY",
    "phase_step_minutes": 15,
    "phase_formula": "target_due = ceil_to_minute(actual_wake_time + 15 minutes)",
    "timing_mode": "exact_schedule",
    "next_wake_first": true,
    "note": "Each wake sets the same hourly RRULE's BYMINUTE from actual wake/start +15m (rounded up to whole minute). This prevents near-immediate rearm after delayed wakes and the resulting ~1h missed-slot gap.",
    "minimum_lead_minutes": 15,
    "compute_from_actual_wake_time": true,
    "stale_phase_reuse_forbidden": true
  },
  "utilization": {
    "first_class_objective": true,
    "start_work_immediately_after_wake_verification": true,
    "voluntary_idle_while_useful_work_exists_forbidden": true,
    "checkpoint_is_yield_condition": false,
    "milestone_is_yield_condition": false,
    "document_boundary_is_yield_condition": false,
    "root_completion_is_yield_condition": false,
    "scheduled_time_is_yield_condition": false,
    "normal_final_response_while_active_predecessor_forbidden": true,
    "nonterminal_voluntary_turn_end_forbidden": true,
    "after_each_work_unit": "SELECT_AND_EXECUTE_NEXT_USEFUL_UNIT_IN_SAME_TURN",
    "no_obvious_unit_action": "INSPECT_DURABLE_STATE_FOR_HIGHEST_VALUE_UNRESOLVED_INVARIANT"
  },
  "program_continuity": {
    "enabled": true,
    "root_completion_does_not_imply_program_completion": true,
    "on_root_complete": [
      "PERSIST_ROOT_TERMINAL_EVIDENCE",
      "EVALUATE_MATERIALLY_USEFUL_NEXT_ROOT",
      "IF_USEFUL_PERSIST_NEXT_ROOT_BEFORE_RELINQUISHING",
      "CONTINUE_WITHOUT_VOLUNTARY_IDLE"
    ],
    "busywork_for_continuity_forbidden": true,
    "program_stop_requires_one_of": [
      "EXPLICIT_OPERATOR_STOP",
      "VERIFIED_PROGRAM_COMPLETE",
      "BLOCKED_EXTERNAL_WITH_INTERNAL_ALTERNATIVES_EXHAUSTED"
    ]
  },
  "activity_evidence": {
    "path": "state/ACTIVITY.json",
    "mark_working_at_run_start": true,
    "refresh_after_meaningful_work_unit": true,
    "maximum_heartbeat_gap_minutes_when_practical": 5,
    "foreground_ui_is_advisory_not_authoritative": true,
    "operator_idle_ui_plus_no_fresh_durable_activity_is_utilization_gap": true
  },
  "handoff": {
    "trigger": "SUCCESSOR_ACTUALLY_OBSERVED",
    "scheduled_time_alone_is_trigger": false,
    "on_trigger": [
      "STOP_STARTING_NEW_SUBSTANTIVE_UNITS",
      "FINISH_CURRENT_SMALLEST_SAFE_UNIT",
      "PERSIST_HANDOFF_CHECKPOINT",
      "PERSIST_ACTIVITY_HANDOFF",
      "EMIT_CONCISE_STATUS",
      "PREDECESSOR_END"
    ],
    "successor_must_avoid_duplicate_active_unit": true,
    "same_canonical_overlap_required_for_correctness": false,
    "same_canonical_overlap_preferred_for_utilization": true
  },
  "fallback": {
    "self_update_failure_with_old_rrule_intact": "DEGRADED_CONTINUATION",
    "old_rrule_may_act_as_recovery_opportunity": true,
    "disabled_deleted_missing_automation_self_rescued": false
  },
  "authority": {
    "chat_is_authoritative": false,
    "durable_state_is_authoritative": true,
    "stale_authority_substantive_write_forbidden": true
  },
  "safety": {
    "public_repo": true,
    "secrets_allowed": false,
    "private_source_material_allowed": false,
    "ambiguous_irreversible_effect_blind_replay_forbidden": true,
    "duplicate_substantive_execution_forbidden": true
  },
  "terminal": {
    "root_complete_requires_evidence": true,
    "program_complete_requires_evidence": true,
    "disable_same_canonical_only_on_program_terminal": true,
    "program_terminal_schedules_successor": false,
    "voluntary_turn_end_allowed_only_for": [
      "PROGRAM_COMPLETE",
      "BLOCKED_EXTERNAL",
      "COMMITTED_SUCCESSOR_HANDOFF",
      "EXPLICIT_OPERATOR_STOP",
      "PLATFORM_ENFORCED_TERMINATION"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RRuleR Effect Receipt Record",
  "type": "object",
  "required": ["schema_version", "effect_id", "root_job_id", "work_unit_id", "authority_epoch", "operation", "target_ref", "status", "receipt"],
  "properties": {
    "schema_version": {"type": "string"},
    "effect_id": {"type": "string"},
    "root_job_id": {"type": "string"},
    "work_unit_id": {"type": "string"},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "operation": {"type": "string"},
    "target_ref": {"type": "string"},
    "status": {"enum": ["NOT_STARTED", "CONFIRMED", "AMBIGUOUS"]},
    "receipt": {"type": ["string", "null"]}
  }
}
